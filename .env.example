# Gemini (ekstre okuma, tarihsel olay analizi, temettü araması)
GEMINI_API_KEY=

# Supabase (auth + veritabanı) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# scripts/run-schema.mjs ile şema uygulamak için — Project Settings > Database > Connection string (Session pooler değil, "Direct connection")
POSTGRES_URL_NON_POOLING=

# Bildirim cron endpoint'ini (api/notifications/check) korumak için, kendin belirlediğin bir sır
CRON_SECRET=

# Web Push (fiyat alarmı / hatırlatma bildirimleri) — `npx web-push generate-vapid-keys` ile üretilir
VAPID_SUBJECT=mailto:your-email@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
